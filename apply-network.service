# /etc/systemd/system/apply-network.service

[Unit]
Description=Apply network.txt Wi-Fi config at boot
After=local-fs.target network-pre.target
Before=network.target
Wants=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/apply-network.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
